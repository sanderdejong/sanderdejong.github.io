---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentWithHeading from '../components/ContentWithHeading.astro';

Astro.response.status = 404;
---
<BaseLayout pageTitle="Page not found - Sander de Jong" portrait="small">
    <ContentWithHeading>
        <h1>page not found<span class="period">.</span></h1>
        <p>
            The page you’re looking for doesn’t exist. Return to <a href="/">the home page</a>.
        </p>
    </ContentWithHeading>
</BaseLayout>

