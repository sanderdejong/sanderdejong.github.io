---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentWithHeading from '../components/ContentWithHeading.astro';
import AboutSection from '../components/AboutSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import PhotographySection from '../components/PhotographySection.astro';
import ContactSection from '../components/ContactSection.astro';

const siteUrl = Astro.site?.toString() ?? 'https://sanderdejong.dev/';
const description =
    'Sander de Jong — Software & AWS Cloud Engineer with 6+ years of experience building cloud-native Java, AWS, distributed, and serverless systems.';

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': `${siteUrl}#person`,
            name: 'Sander de Jong',
            url: siteUrl,
            image: new URL('/og.png', siteUrl).toString(),
            jobTitle: 'Software & AWS Cloud Engineer',
            description,
            email: 'mailto:hi@sanderdejong.dev',
            sameAs: [
                'https://github.com/sanderdejong',
                'https://linkedin.com/in/sanderdejong-',
            ],
            knowsAbout: [
                'Java',
                'Amazon Web Services (AWS)',
                'Cloud-Native Development',
                'Distributed Systems',
                'Serverless Architecture',
                'Container Architecture',
                'Infrastructure as Code',
            ],
        },
        {
            '@type': 'WebSite',
            '@id': `${siteUrl}#website`,
            url: siteUrl,
            name: 'Sander de Jong',
            description,
            inLanguage: 'en',
            author: { '@id': `${siteUrl}#person` },
        },
        {
            '@type': 'ProfilePage',
            '@id': `${siteUrl}#webpage`,
            url: siteUrl,
            name: 'Sander de Jong - Software & AWS Cloud Engineer',
            description,
            isPartOf: { '@id': `${siteUrl}#website` },
            mainEntity: { '@id': `${siteUrl}#person` },
            inLanguage: 'en',
        },
    ],
};
---
<BaseLayout pageDescription={description} structuredData={structuredData}>
    <ContentWithHeading>
        <hgroup>
            <h1 class="hero-title">
                <span class="hero-greeting">hi, I am</span>
                <span class="nowrap">Sander de Jong<span class="period">.</span></span>
            </h1>
            <p class="standfirst">Software &amp; AWS Cloud Engineer</p>
        </hgroup>
        <p>
            I have over six years of professional experience, in both small teams and large organizations. I specialize in
            cloud-native development, primarily using Java and AWS.
        </p>
    </ContentWithHeading>
    <div class="portfolio-sections" slot="sections">
        <AboutSection />
        <ProjectsSection />
        <PhotographySection />
        <ContactSection />
    </div>
</BaseLayout>

<style>
    hgroup h1.hero-title {
        font-size: min(clamp(2.75rem, 5vw + 0.85rem, 4.85rem), 12.2cqi);
        line-height: 1.02;
    }

    .hero-greeting {
        display: block;
        font-size: clamp(1.5rem, 1.8vw + 0.85rem, 2.35rem);
        font-weight: 500;
        letter-spacing: -0.015em;
        line-height: 1.2;
        margin-bottom: 0.12em;
    }

    .portfolio-sections {
        display: grid;
        gap: var(--section-pad);
        grid-column: 1 / -1;
        min-width: 0;
        padding-block-end: var(--section-pad);
    }
</style>
