---
import "../styles/global.css";
import {Font, Image} from 'astro:assets';
import profilePic from '../assets/profile.png';
import Navbar from '../components/Navbar.astro';

interface Props {
    pageAuthor?: string;
    pageTitle?: string;
    pageDescription?: string;
    portrait?: boolean;
    robots?: string;
    structuredData?: Record<string, unknown>;
}

const {
    pageAuthor = "Sander de Jong",
    pageTitle = "Sander de Jong - Software & AWS Cloud Engineer",
    pageDescription = "Sander de Jong — Software & AWS Cloud Engineer with 6+ years of experience building cloud-native Java, AWS, distributed, and serverless systems.",
    portrait = true,
    robots = "index, follow",
    structuredData,
} = Astro.props;

const themeColor = {light: '#fdf9f3', dark: '#1b1614'};

const isNoIndex = robots.includes('noindex');
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const socialImageURL = new URL('/og.png', Astro.site || Astro.url.origin);
const year = new Date().getFullYear();
---

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <title>{pageTitle}</title>

    <meta name="author" content={pageAuthor}/>
    <meta name="description" content={pageDescription}/>
    <meta name="robots" content={robots}/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)"/>
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)"/>

    {!isNoIndex && <link rel="canonical" href={canonicalURL}/>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <Font cssVariable="--font-display" preload/>
    <Font cssVariable="--font-body" preload/>
    <Font cssVariable="--font-mono" preload/>

    <!-- Open Graph -->
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content={pageAuthor}/>
    <meta property="og:locale" content="en_US"/>
    {!isNoIndex && <meta property="og:url" content={canonicalURL}/>}
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={pageDescription}/>
    <meta property="og:image" content={socialImageURL}/>
    <meta property="og:image:type" content="image/png"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Sander de Jong, Software & AWS Cloud Engineer"/>

    <!-- X -->
    <meta name="twitter:card" content="summary_large_image"/>
    {!isNoIndex && <meta name="twitter:url" content={canonicalURL}/>}
    <meta name="twitter:title" content={pageTitle}/>
    <meta name="twitter:description" content={pageDescription}/>
    <meta name="twitter:image" content={socialImageURL}/>
    <meta name="twitter:image:alt" content="Sander de Jong, Software & AWS Cloud Engineer"/>

    {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <script is:inline define:vars={{themeColor}}>
        // Runs after the theme-color metas so it can set them; still before first paint: a saved choice wins, otherwise follow the system.
        // The Navbar toggle calls applyTheme too, so the colours live only in this layout.
        window.applyTheme = (isDark, doc = document) => {
            doc.documentElement.classList.toggle('dark', isDark);
            doc.documentElement.classList.toggle('light', !isDark);
            doc.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', isDark ? themeColor.dark : themeColor.light));
        };
        const saved = localStorage.getItem('theme');
        window.applyTheme(saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches);
    </script>
</head>

<body>
<a class="skip-link" href="#main">Skip to content</a>
<Navbar />
<main class="layout" id="main" tabindex="-1">
    <div class="layout-wrapper container" id={Astro.slots.has("sections") ? "home" : undefined}>
        {portrait && (
            <div class="sidebar">
                <div class="sidebar-inner">
                    <div class="profile">
                        <div class="profile-wrapper">
                            <Image src={profilePic}
                                   loading="eager"
                                   fetchpriority="high"
                                   format="webp"
                                   quality={90}
                                   alt="Pixel-art portrait of Sander de Jong"
                                   class="profile-image"
                                   width={460}
                                   height={460}
                            />
                        </div>
                    </div>
                </div>
            </div>
        )}

        <article class="content">
            <slot/>
        </article>
        <slot name="sections"/>
    </div>
</main>
<footer class="site-footer">
    <div class="footer-bar container">
        <p class="footer-copy">&copy; {year} {pageAuthor}</p>
    </div>
</footer>

<script>
    const syncBandDotGrids = () => {
        const bodyTop = document.body.getBoundingClientRect().top;
        document.querySelectorAll<HTMLElement>('.about-band, .photo-band').forEach((band) => {
            const offset = band.getBoundingClientRect().top - bodyTop;
            band.style.setProperty('--dot-offset-y', `${-offset}px`);
        });
    };

    let resizeFrame = 0;
    const scheduleSyncBandDotGrids = () => {
        if (resizeFrame) return;
        resizeFrame = requestAnimationFrame(() => {
            resizeFrame = 0;
            syncBandDotGrids();
        });
    };

    syncBandDotGrids();
    window.addEventListener('resize', scheduleSyncBandDotGrids, { passive: true });
    document.fonts?.ready.then(syncBandDotGrids);

    // Suppress :focus-visible rings after touch/pointer interactions (including dialog open/close),
    // while immediately restoring them on any keyboard navigation.
    window.addEventListener(
        'pointerdown',
        () => {
            document.documentElement.dataset.input = 'pointer';
        },
        { capture: true, passive: true },
    );
    window.addEventListener(
        'keydown',
        (event) => {
            if (event.metaKey || event.ctrlKey || event.altKey) return;
            if (event.key === 'Shift' || event.key === 'Control' || event.key === 'Alt' || event.key === 'Meta') return;
            delete document.documentElement.dataset.input;
        },
        { capture: true },
    );

    // Interactive dot-grid lens distortion across the page canvas and dark bands (fine pointers, motion-safe).
    if (
        window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
        const RADIUS = 170;
        const SIZE = RADIUS * 2 + 24;
        const HALF = SIZE / 2;
        const STEP = 20;
        const MAX_PUSH = 2.2;

        const createLensLayer = (host: HTMLElement, isBand: boolean) => {
            const clip = document.createElement('div');
            clip.className = isBand ? 'band-lens-clip' : 'page-lens-clip';
            clip.setAttribute('aria-hidden', 'true');
            const canvas = document.createElement('canvas');
            canvas.className = 'dot-lens-canvas';
            canvas.style.width = `${SIZE}px`;
            canvas.style.height = `${SIZE}px`;
            clip.appendChild(canvas);
            host.prepend(clip);
            const ctx = canvas.getContext('2d');
            return { host, clip, canvas, ctx, isBand, visible: false, top: 0, bottom: 0, width: 0 };
        };

        const layers = [
            createLensLayer(document.body, false),
            ...Array.from(document.querySelectorAll<HTMLElement>('.about-band, .photo-band')).map((band) =>
                createLensLayer(band, true),
            ),
        ];

        // Resolve CSS tokens (including light-dark() and color-mix()) to canvas-ready colors.
        const probe = document.createElement('span');
        probe.style.cssText = 'position:fixed;visibility:hidden;pointer-events:none;';
        document.body.appendChild(probe);

        const resolveColor = (expr: string) => {
            probe.style.color = '';
            probe.style.color = expr;
            return getComputedStyle(probe).color;
        };

        const zeroAlpha = (c: string) => {
            const rgb = c.match(/^rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/);
            if (rgb) return `rgba(${rgb[1]}, ${rgb[2]}, ${rgb[3]}, 0)`;
            if (c.includes('/')) return c.replace(/\/[^)]+\)/, '/ 0)');
            return c.replace(/\)$/, ' / 0)');
        };

        let palette = {
            paper: '',
            paperClear: '',
            band: '',
            bandClear: '',
            dot: '',
            bandDot: '',
            accent: '',
            pop: '',
            glowPaper: '',
            glowPaperClear: '',
            glowBand: '',
            glowBandClear: '',
        };

        const syncPalette = () => {
            const paper = resolveColor('var(--color-paper)');
            const band = resolveColor('var(--color-band)');
            const glowPaper = resolveColor('color-mix(in oklab, var(--color-accent) 3.5%, transparent)');
            const glowBand = resolveColor('color-mix(in oklab, var(--color-pop) 4.5%, transparent)');
            palette = {
                paper,
                paperClear: zeroAlpha(paper),
                band,
                bandClear: zeroAlpha(band),
                dot: resolveColor('var(--color-dot)'),
                bandDot: resolveColor('var(--color-band-dot)'),
                accent: resolveColor('color-mix(in oklab, var(--color-accent) 44%, transparent)'),
                pop: resolveColor('color-mix(in oklab, var(--color-pop) 48%, transparent)'),
                glowPaper,
                glowPaperClear: zeroAlpha(glowPaper),
                glowBand,
                glowBandClear: zeroAlpha(glowBand),
            };
        };

        let dpr = Math.min(window.devicePixelRatio || 1, 2);
        let bodyHeight = document.body.scrollHeight;
        const resizeCanvases = () => {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            const bodyRect = document.body.getBoundingClientRect();
            bodyHeight = document.body.scrollHeight;
            for (const layer of layers) {
                layer.canvas.width = Math.round(SIZE * dpr);
                layer.canvas.height = Math.round(SIZE * dpr);
                if (layer.isBand) {
                    const rect = layer.host.getBoundingClientRect();
                    layer.top = rect.top - bodyRect.top;
                    layer.bottom = rect.bottom - bodyRect.top;
                    layer.width = layer.clip.clientWidth || window.innerWidth;
                } else {
                    layer.top = 0;
                    layer.bottom = bodyHeight;
                    layer.width = document.body.clientWidth || window.innerWidth;
                }
            }
        };

        syncPalette();
        resizeCanvases();

        let clientX = -999;
        let clientY = -999;
        let pointerActive = false;
        let frame = 0;

        const edgeAlpha = (px: number, py: number, width: number, bodyHeight: number, isBand: boolean) => {
            const xFrac = px / width;
            const horiz = Math.min(1, xFrac / 0.18, (1 - xFrac) / 0.18);
            if (horiz <= 0) return 0;
            if (isBand) return horiz;
            const vert = Math.min(1, py / 180, (bodyHeight - py) / 180);
            return vert <= 0 ? 0 : horiz * vert;
        };

        const render = () => {
            frame = 0;
            const pageX = clientX + window.scrollX;
            const pageY = clientY + window.scrollY;

            for (const layer of layers) {
                const { ctx, canvas, isBand, top, bottom, width } = layer;
                if (!ctx) continue;

                const inRange = pointerActive && pageY >= top - RADIUS && pageY <= bottom + RADIUS;
                if (!inRange) {
                    if (layer.visible) {
                        layer.visible = false;
                        canvas.classList.remove('is-active');
                    }
                    continue;
                }

                const localX = pageX;
                const localY = pageY - top;
                const originX = localX - HALF;
                const originY = localY - HALF;

                canvas.style.transform = `translate3d(${originX}px, ${originY}px, 0)`;
                if (!layer.visible) {
                    layer.visible = true;
                    canvas.classList.add('is-active');
                }

                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                ctx.clearRect(0, 0, SIZE, SIZE);

                // Softly cover the static base dots inside the lens so distorted dots never double up.
                const bg = isBand ? palette.band : palette.paper;
                const bgClear = isBand ? palette.bandClear : palette.paperClear;
                const cover = ctx.createRadialGradient(HALF, HALF, 0, HALF, HALF, RADIUS);
                cover.addColorStop(0, bg);
                cover.addColorStop(0.76, bg);
                cover.addColorStop(1, bgClear);
                ctx.fillStyle = cover;
                ctx.fillRect(0, 0, SIZE, SIZE);

                // Whisper-subtle ambient warmth at the center of the lens (respects page edge fades).
                const centerEdge = edgeAlpha(pageX, pageY, width, bodyHeight, isBand);
                if (centerEdge > 0.01) {
                    const glow = ctx.createRadialGradient(HALF, HALF, 0, HALF, HALF, RADIUS * 0.85);
                    glow.addColorStop(0, isBand ? palette.glowBand : palette.glowPaper);
                    glow.addColorStop(1, isBand ? palette.glowBandClear : palette.glowPaperClear);
                    ctx.globalAlpha = centerEdge;
                    ctx.fillStyle = glow;
                    ctx.fillRect(0, 0, SIZE, SIZE);
                }

                // Grid origin matches CSS `background-position: 50% 0` (20px tiles with dot center at +10px).
                const gridOriginX = width / 2;
                const kStart = Math.floor((pageX - RADIUS - gridOriginX) / STEP);
                const kEnd = Math.ceil((pageX + RADIUS - gridOriginX) / STEP);
                const mStart = Math.floor((pageY - RADIUS - 10) / STEP);
                const mEnd = Math.ceil((pageY + RADIUS - 10) / STEP);

                const baseDot = isBand ? palette.bandDot : palette.dot;
                const accentDot = isBand ? palette.pop : palette.accent;

                for (let k = kStart; k <= kEnd; k++) {
                    const gx = gridOriginX + k * STEP;
                    const dx = gx - pageX;
                    for (let m = mStart; m <= mEnd; m++) {
                        const gy = 10 + m * STEP;
                        const dy = gy - pageY;
                        const dist = Math.hypot(dx, dy);
                        if (dist >= RADIUS) continue;

                        const ea = edgeAlpha(gx, gy, width, bodyHeight, isBand);
                        if (ea <= 0.01) continue;

                        const u = 1 - dist / RADIUS; // 1 at cursor, 0 at edge
                        const ease = u * u * (3 - 2 * u); // smoothstep

                        // Gentle convex lens displacement (0 at center & edge, peaks smoothly mid-ring).
                        const push = dist > 0.001 ? Math.sin(Math.PI * u) * MAX_PUSH : 0;
                        const nx = dist > 0.001 ? dx / dist : 0;
                        const ny = dist > 0.001 ? dy / dist : 0;

                        const cx = gx + nx * push - originX;
                        const cy = gy - top + ny * push - originY;
                        const radius = 1 + ease * 0.45;

                        // Base dot (fades cleanly at page edges just like body::before / band::before).
                        ctx.globalAlpha = ea * (1 - ease * 0.45);
                        ctx.fillStyle = baseDot;
                        ctx.beginPath();
                        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                        ctx.fill();

                        // Warm accent highlight blended in proportionally to proximity & edge fade.
                        if (ease > 0.02) {
                            ctx.globalAlpha = ea * ease;
                            ctx.fillStyle = accentDot;
                            ctx.beginPath();
                            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    }
                }
                ctx.globalAlpha = 1;
            }
        };

        const scheduleRender = () => {
            if (!frame) frame = requestAnimationFrame(render);
        };

        window.addEventListener(
            'pointermove',
            (e) => {
                if (e.pointerType !== 'mouse') return;
                clientX = e.clientX;
                clientY = e.clientY;
                pointerActive = true;
                scheduleRender();
            },
            { passive: true },
        );

        window.addEventListener(
            'scroll',
            () => {
                if (pointerActive) scheduleRender();
            },
            { passive: true },
        );

        document.documentElement.addEventListener('pointerleave', () => {
            pointerActive = false;
            for (const layer of layers) {
                layer.visible = false;
                layer.canvas.classList.remove('is-active');
            }
        });

        window.addEventListener(
            'resize',
            () => {
                resizeCanvases();
                if (pointerActive) scheduleRender();
            },
            { passive: true },
        );

        document.fonts?.ready.then(resizeCanvases);
        if ('ResizeObserver' in window) {
            new ResizeObserver(resizeCanvases).observe(document.body);
        }

        // Re-resolve colors when light/dark theme toggles on <html>.
        new MutationObserver(() => {
            syncPalette();
            if (pointerActive) scheduleRender();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    }
</script>

</body>
</html>

<style is:global>
    html, body { overflow-x: clip; }

    .skip-link {
        position: fixed;
        top: var(--space-xs);
        left: var(--space-xs);
        z-index: calc(var(--z-sticky-nav) + 1);
        padding: var(--space-xs) var(--space-sm);
        background: var(--color-ink);
        color: var(--color-paper);
        font-weight: 500;
        text-decoration: none;
        transform: translateY(calc(-100% - var(--space-md)));
    }

    .skip-link:focus-visible {
        transform: none;
    }

    #main:focus {
        outline: none;
    }

    .page-lens-clip {
        position: absolute;
        inset: 0;
        overflow: hidden;
        z-index: -1;
        pointer-events: none;
    }

    .band-lens-clip {
        position: absolute;
        inset-block: 0;
        left: 50%;
        width: 100dvw;
        transform: translateX(-50%);
        overflow: hidden;
        z-index: -1;
        pointer-events: none;
    }

    .dot-lens-canvas {
        position: absolute;
        top: 0;
        left: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 280ms var(--ease-out);
    }

    .dot-lens-canvas.is-active {
        opacity: 1;
        will-change: transform;
    }
</style>

<style>
    .layout {
        --section-pad: var(--space-3xl);
        flex: 1;
        display: grid;
        align-content: start;
        padding-block: var(--space-2xl) var(--space-3xl);
    }

    .layout:has(#home) {
        padding-block: var(--space-2xl) 0;
    }

    .layout-wrapper {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        column-gap: var(--gap-columns);
        row-gap: var(--section-gap-s);
        align-items: start;
    }

    #home {
        row-gap: var(--section-gap-s);
        scroll-margin-top: 100vh;
    }

    .sidebar,
    .sidebar-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }

    .profile {
        width: min(100%, clamp(160px, 46vw, 250px));
        justify-self: center;
        container: portrait / inline-size;
    }

    /*
     * The portrait is pixel art from a 460px source. It fills its column; whenever that draws it
     * larger than the source it upscales with hard pixels, and downscales stay smooth so the
     * scanlines don't alias.
     */
    .profile-wrapper {
        width: 100%;
        aspect-ratio: 1;
        border-radius: var(--radius-portrait);
        overflow: hidden;
        background: var(--color-paper-2);
        border: 1px solid color-mix(in oklab, var(--color-accent) 28%, var(--color-border));
        box-shadow: var(--shadow-portrait);
    }

    @container portrait (min-width: 460px) {
        .profile-wrapper :global(img) { image-rendering: pixelated; }
    }

    @media (min-resolution: 2dppx) {
        @container portrait (min-width: 230px) {
            .profile-wrapper :global(img) { image-rendering: pixelated; }
        }
    }

    .profile-wrapper :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(var(--portrait-brightness));
    }

    .content {
        min-width: 0;
    }

    @media (max-width: 60rem) {
        .layout {
            --section-pad: var(--space-2xl);
            padding-block: var(--space-xl) var(--space-2xl);
        }

        .layout:has(#home) {
            padding-block: var(--space-xl) 0;
        }
    }

    @media (width > 40rem) {
        /* The portrait column grows with the window, so the portrait scales smoothly from ~160px to 460px. */
        .layout-wrapper {
            grid-template-columns: minmax(0, 1fr) clamp(160px, 38vw - 84px, 460px);
        }

        .sidebar {
            grid-column: 2;
            grid-row: 1;
            align-self: center;
        }

        .profile {
            width: 100%;
        }

        .content {
            grid-column: 1;
            grid-row: 1;
            align-self: center;
        }
    }

    .site-footer {
        color: var(--color-muted);
    }

    .footer-bar {
        display: flex;
        justify-content: center;
        padding-block: 0 calc(var(--space-2xl) + var(--space-lg));
        text-align: center;
    }

    .footer-copy {
        margin: 0;
        font-size: var(--text-sm);
        color: inherit;
    }
</style>
