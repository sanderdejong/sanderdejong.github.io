---
import "../styles/global.css";
import '@fontsource/oswald/700.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import {ClientRouter} from 'astro:transitions';
import {Image, getImage} from 'astro:assets';
import profilePic from '../assets/profile.png';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
    pageAuthor?: string;
    pageTitle?: string;
    pageDescription?: string;
    portrait?: "full" | "small" | "none";
    missingTile?: boolean;
}

const {
    pageAuthor = "Sander de Jong",
    pageTitle = "Sander de Jong - Software & AWS Cloud Engineer",
    pageDescription = "Sander de Jong, Software & AWS Cloud Engineer with over six years of experience in cloud-native development with Java and AWS.",
    portrait = "full",
    missingTile = false
} = Astro.props;

// Same options as the <Image> below, so the tile reuses the portrait's file instead of a second one.
const tileSource = missingTile
    ? await getImage({src: profilePic, format: 'webp', quality: 90, width: 460, height: 460})
    : null;

const themeColor = {light: '#f4e9e2', dark: '#291527'};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const socialImageURL = new URL('/og.png', Astro.site || Astro.url.origin);
const routePath = Astro.url.pathname.replace(/\/$/, '');
const showSignoffLinks = routePath !== '/contact';
---

<html lang="en">
<head>
    <title>{pageTitle}</title>

    <link rel="canonical" href={canonicalURL}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>

    <meta charset="utf-8"/>
    <meta name="author" content={pageAuthor}/>
    <meta name="description" content={pageDescription}/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="generator" content={Astro.generator}/>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content={Astro.url}/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={pageDescription}/>
    <meta property="og:image" content={socialImageURL}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Sander de Jong, Software & AWS Cloud Engineer"/>

    <!-- X -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:url" content={Astro.url}/>
    <meta name="twitter:title" content={pageTitle}/>
    <meta name="twitter:description" content={pageDescription}/>
    <meta name="twitter:image" content={socialImageURL}/>

    <meta name="robots" content="index, follow"/>
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)"/>
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)"/>
    <script is:inline define:vars={{themeColor}}>
        // Runs after the theme-color metas so it can set them; still before first paint: a saved choice wins, otherwise follow the system.
        // The Navbar toggle calls applyTheme too, so the colours live only in this layout.
        window.applyTheme = (isDark, doc = document) => {
            doc.documentElement.classList.toggle('dark', isDark);
            doc.documentElement.classList.toggle('light', !isDark);
            doc.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', isDark ? themeColor.dark : themeColor.light));
        };
        const saved = localStorage.getItem('theme');
        window.applyTheme(saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches);

        // Carry the theme across Astro view transitions.
        document.addEventListener('astro:before-swap', (ev) => {
            window.applyTheme(document.documentElement.classList.contains('dark'), ev.newDocument);
        });
    </script>
    <ClientRouter/>
</head>

<body>
<a class="skip-link" href="#main">Skip to content</a>
<Navbar />
<main class="layout" id="main" tabindex="-1">
    <section class="layout-wrapper container" data-portrait={portrait}
             data-missing-tile={missingTile ? "" : undefined}
             style={tileSource ? `--portrait-src: url(${tileSource.src})` : undefined}>
        <div class="sidebar">
            <div class="sidebar-inner" transition:persist="sidebar">
                <div class="profile">
                    <div class="profile-wrapper">
                        <Image src={profilePic}
                               loading="eager"
                               fetchpriority="high"
                               format="webp"
                               quality={90}
                               alt="Pixel-art portrait of Sander de Jong"
                               class="profile-image"
                               width={460}
                               height={460}
                        />
                    </div>
                </div>
            </div>
        </div>

        <article class="content">
            <slot/>
            <Footer author={pageAuthor} showLinks={showSignoffLinks} />
        </article>
    </section>
</main>

</body>
</html>

<style is:global>
    html, body { overflow-x: clip; }

    .skip-link {
        position: absolute;
        top: var(--space-xs);
        left: var(--space-xs);
        z-index: calc(var(--z-sticky-nav) + 1);
        padding: var(--space-xs) var(--space-sm);
        background: var(--color-ink);
        color: var(--color-paper);
        font-weight: 500;
        text-decoration: none;
        transform: translateY(calc(-100% - var(--space-md)));
    }

    .skip-link:focus-visible {
        transform: none;
    }

    #main:focus {
        outline: none;
    }

    /* Between routes the portrait glides to its new size and the nav mark slides along the rule with it. Neither fades. */
    ::view-transition-group(portrait),
    ::view-transition-group(nav-mark) {
        animation-duration: var(--dur-long);
        animation-timing-function: var(--ease-out);
    }

    ::view-transition-old(portrait),
    ::view-transition-old(nav-mark) {
        animation: none;
        opacity: 0;
    }

    ::view-transition-new(portrait),
    ::view-transition-new(nav-mark) {
        animation: none;
    }

    ::view-transition-new(nav-mark) {
        height: 100%;
    }
</style>

<style>
    .layout {
        flex: 1;
        display: grid;
        align-content: start;
        padding-block: var(--space-2xl) var(--space-3xl);
    }

    .layout-wrapper {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gap-columns);
        align-items: start;
    }

    .sidebar,
    .sidebar-inner {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / span 5;
    }

    .sidebar-inner {
        grid-column: 1 / -1;
        view-transition-name: portrait;
    }

    .profile {
        grid-column: 1 / -1;
        container: portrait / inline-size;
    }

    /*
     * The portrait is pixel art from a 460px source. It fills its column; whenever that draws it
     * larger than the source it upscales with hard pixels, and downscales stay smooth so the
     * scanlines don't alias. It stands on a tangerine block that steps with it in whole pixels:
     * 6px small, 10px mid, 14px from 400px (the fallen 404 tile casts 3, 4, 6px).
     */
    .profile-wrapper {
        --cast: 6px;
        --tile-cast: 3px;
        width: 100%;
        aspect-ratio: 1;
        background: var(--color-paper-2);
        box-shadow: var(--cast) var(--cast) 0 var(--color-cast);
    }

    @container portrait (min-width: 200px) {
        .profile-wrapper { --cast: 10px; --tile-cast: 4px; }
    }

    @container portrait (min-width: 400px) {
        .profile-wrapper { --cast: 14px; --tile-cast: 6px; }
    }

    @container portrait (min-width: 460px) {
        .profile-wrapper :global(img) { image-rendering: pixelated; }
    }

    @media (min-resolution: 2dppx) {
        @container portrait (min-width: 230px) {
            .profile-wrapper :global(img) { image-rendering: pixelated; }
        }
    }

    .profile-wrapper :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(var(--portrait-brightness));
        outline: 2px solid var(--color-ink);
        outline-offset: -2px;
    }

    /*
     * The 404: the page is missing, and so is one tile of the portrait. The top-right fifth of the
     * grid drops out of its socket and lands on the floor beside the frame, in hard pixel steps.
     */
    .profile-wrapper { position: relative; }

    [data-missing-tile] .profile-wrapper::after,
    [data-missing-tile] .profile-wrapper::before {
        content: "";
        position: absolute;
        width: 20%;
        aspect-ratio: 1;
        box-sizing: border-box;
    }

    [data-missing-tile] .profile-wrapper::after {
        top: 0;
        right: 0;
        z-index: 1;
        background: var(--color-paper-3);
        border: 2px solid var(--color-ink);
    }

    [data-missing-tile] .profile-wrapper::before {
        left: calc(100% + var(--space-sm));
        bottom: 0;
        z-index: 2;
        background: var(--portrait-src) 100% 0 / 500% no-repeat;
        filter: brightness(var(--portrait-brightness));
        outline: 2px solid var(--color-ink);
        outline-offset: -2px;
        box-shadow: var(--tile-cast) var(--tile-cast) 0 var(--color-cast);
        animation: tile-drop 720ms steps(6, jump-end) 600ms both;
    }

    @keyframes tile-drop {
        0% { transform: translate(calc(-100% - var(--space-sm)), -400%); }
        20% { transform: translate(calc(-100% - var(--space-sm) + 30%), -400%); }
        100% { transform: translate(0, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
        [data-missing-tile] .profile-wrapper::before { animation: none; }
    }

    /* Home carries the full portrait; secondary pages keep a small mark of it. */
    [data-portrait="small"] .sidebar {
        grid-column: 1 / span 3;
    }

    [data-portrait="small"] .content {
        grid-column: 5 / -1;
    }

    [data-portrait="none"] .sidebar {
        display: none;
    }

    [data-portrait="none"] .content {
        grid-column: 1 / span 8;
    }

    .content {
        grid-column: 7 / -1;
        min-width: 0;
    }

    @media (max-width: 60rem) {
        .layout {
            padding-block: var(--space-xl) var(--space-2xl);
        }

        .layout-wrapper {
            grid-template-columns: minmax(0, 1fr);
            row-gap: var(--space-xl);
        }

        .sidebar,
        .sidebar-inner,
        .profile,
        .content {
            grid-column: 1 / -1;
        }

        .sidebar,
        .sidebar-inner {
            grid-template-columns: minmax(0, 1fr);
        }

        .profile {
            width: 230px;
        }

        [data-portrait="small"] .profile {
            width: 115px;
        }

        [data-portrait] .sidebar,
        [data-portrait] .content {
            grid-column: 1 / -1;
        }
    }
</style>
