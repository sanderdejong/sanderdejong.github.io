---
interface Props {
    author?: string;
}

const { author = "Sander de Jong" } = Astro.props;
---

<footer class="signoff">
    <p class="signoff-meta">© {new Date().getFullYear()} <span class="nowrap">{author},</span> <span class="nowrap">Software &amp; AWS Cloud Engineer</span></p>
</footer>

<style>
    .signoff {
        margin-top: var(--space-xl);
        padding-top: var(--space-sm);
        border-top: var(--rule-hair) solid var(--color-rule);
    }

    .nowrap {
        white-space: nowrap;
    }

    .signoff-meta {
        margin: 0;
        font-size: var(--text-sm);
        color: var(--color-muted);
    }
</style>
