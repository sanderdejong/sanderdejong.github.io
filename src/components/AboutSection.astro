---
import ContentWithHeading from './ContentWithHeading.astro';
---
    <ContentWithHeading id="about">
        <div class="about-band">
            <h2 id="about-heading">more about me<span class="period">.</span></h2>
            <div class="about-chunks">
                <section class="about-chunk" aria-labelledby="about-build">
                    <h3 id="about-build">What I build</h3>
                    <p>
                        My background includes designing and implementing distributed systems, building serverless and
                        container-based architectures, and working with infrastructure-as-code to support reliable
                        deployments. I focus on clean architecture, observability, and performance, with an emphasis on
                        maintainability and <span class="nowrap">long-term</span> sustainability.
                    </p>
                </section>
                <section class="about-chunk" aria-labelledby="about-work">
                    <h3 id="about-work">How I work</h3>
                    <p>
                        I enjoy working closely with product managers, designers, and fellow engineers to turn ideas into
                        well-aligned technical solutions. I’m comfortable taking ownership, giving and receiving feedback,
                        and adapting to changing requirements.
                    </p>
                </section>
                <section class="about-chunk" aria-labelledby="about-outside">
                    <h3 id="about-outside">Outside work</h3>
                    <p>
                        I enjoy bouldering and badminton, and I like to unwind by reading fantasy. I am
                        naturally curious and motivated by continuous improvement, both professionally and personally.
                    </p>
                </section>
            </div>
        </div>
    </ContentWithHeading>

<style>
    .about-band {
        position: relative;
        isolation: isolate;
        display: grid;
        gap: var(--space-xl);
        width: 100%;
        padding-block: var(--section-pad);
        padding-inline: 0;
        color: var(--color-band-ink);
    }

    .about-band::before {
        content: "";
        position: absolute;
        inset-block: 0;
        left: 50%;
        width: 100dvw;
        transform: translateX(-50%);
        z-index: -1;
        pointer-events: none;
        background-color: var(--color-band);
        background-image:
            linear-gradient(to right, var(--color-band), transparent 18%, transparent 82%, var(--color-band)),
            radial-gradient(var(--color-band-dot) 1px, transparent 1px);
        background-size: 100% 100%, 20px 20px;
        background-position: 0 0, 50% var(--dot-offset-y, 0px);
    }

    .about-band h2 {
        font-size: min(var(--text-section), 14cqi);
        max-width: none;
        color: inherit;
        text-wrap: balance;
    }

    .about-band :global(.period) {
        color: var(--color-pop);
    }

    .about-chunks {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        column-gap: var(--space-xl);
        row-gap: var(--space-xl);
        width: 100%;
    }

    .about-chunk {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        min-width: 0;
        padding-block-start: var(--space-lg);
        border-top: var(--rule-hair) solid color-mix(in oklab, var(--color-band-muted) 35%, transparent);
    }

    .about-chunk h3 {
        max-width: none;
        color: inherit;
        font-size: var(--text-title);
        line-height: 1.15;
        text-wrap: balance;
    }

    .about-chunk p {
        max-width: 56ch;
        font-size: var(--text-md);
        line-height: 1.65;
        color: var(--color-band-muted);
    }

    @container (max-width: 52rem) {
        .about-chunks {
            grid-template-columns: minmax(0, 1fr);
            row-gap: var(--space-xl);
        }

        .about-chunk {
            padding-block-start: var(--space-md);
        }
    }
</style>
