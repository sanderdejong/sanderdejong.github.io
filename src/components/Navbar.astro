<nav class="navbar card-surface" aria-label="Main" transition:persist="navbar">
    <div class="nav-bar container">
        <ul class="nav-list">
            <li><a href="/#home" class="nav-link" data-astro-reload>Home<span class="nav-mark" aria-hidden="true"></span></a></li>
            <li><a href="/#about" class="nav-link" data-astro-reload>About<span class="nav-mark" aria-hidden="true"></span></a></li>
            <li><a href="/#projects" class="nav-link" data-astro-reload>Projects<span class="nav-mark" aria-hidden="true"></span></a></li>
            <li><a href="/#photography" class="nav-link" data-astro-reload>Photography<span class="nav-mark" aria-hidden="true"></span></a></li>
            <li><a href="/#contact" class="nav-link" data-astro-reload>Contact<span class="nav-mark" aria-hidden="true"></span></a></li>
        </ul>
        <button class="theme-btn" id="theme-btn" type="button" aria-label="Dark mode" aria-pressed="false" hidden>
            <svg class="theme-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                <path d="M20.8 14.1A9 9 0 0 1 9.9 3.2 9 9 0 1 0 20.8 14.1Z"/>
            </svg>
            <svg class="theme-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v3m0 14v3M2 12h3m14 0h3M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2"/>
            </svg>
        </button>
    </div>
</nav>

<script is:inline>
    (function () {
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        function syncThemeButton() {
            const btn = document.getElementById("theme-btn");
            if (!btn) return;
            const isDark = document.documentElement.classList.contains("dark");
            btn.hidden = false;
            btn.setAttribute("aria-pressed", String(isDark));
            btn.setAttribute("title", isDark ? "Switch to light mode" : "Switch to dark mode");
        }

        function applyTheme(isDark) {
            window.applyTheme(isDark);
            syncThemeButton();
        }

        // The section under the nav (plus a third of the screen) is current; at the very bottom, the last one is.
        function currentHash() {
            const sections = ["about", "projects", "photography", "contact"].map((id) => document.getElementById(id)).filter(Boolean);
            const line = (document.querySelector(".navbar")?.offsetHeight || 0) + window.innerHeight / 3;
            let hash = "#home";
            for (const section of sections) {
                if (section.getBoundingClientRect().top <= line) hash = "#" + section.id;
            }
            const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
            if (atBottom && sections.length) hash = "#" + sections[sections.length - 1].id;
            return hash;
        }

        function syncActiveLink() {
            const { pathname } = window.location;
            const hash = currentHash();
            document.querySelectorAll(".nav-link").forEach((link) => {
                if (link.pathname === pathname && link.hash === hash) {
                    link.setAttribute("aria-current", "location");
                } else {
                    link.removeAttribute("aria-current");
                }
            });
        }

        function initNavbar() {
            syncActiveLink();
            syncThemeButton();

            const btn = document.getElementById("theme-btn");
            if (btn && !btn.dataset.initialized) {
                btn.dataset.initialized = "true";
                btn.addEventListener("click", () => {
                    const isDark = !document.documentElement.classList.contains("dark");
                    // Picking the system's own theme hands control back to the system.
                    if (isDark === media.matches) localStorage.removeItem("theme");
                    else localStorage.setItem("theme", isDark ? "dark" : "light");
                    applyTheme(isDark);
                });
            }
        }

        // Follow the system setting until the visitor picks a theme here.
        media.addEventListener("change", (e) => {
            if (!localStorage.getItem("theme")) applyTheme(e.matches);
        });

        document.addEventListener("astro:page-load", initNavbar);
        document.addEventListener("astro:after-swap", syncActiveLink);
        window.addEventListener("hashchange", syncActiveLink);

        let scrollFrame = 0;
        window.addEventListener("scroll", () => {
            if (scrollFrame) return;
            scrollFrame = requestAnimationFrame(() => {
                scrollFrame = 0;
                syncActiveLink();
            });
        }, { passive: true });
        window.addEventListener("resize", syncActiveLink, { passive: true });
    })();
</script>

<style>
