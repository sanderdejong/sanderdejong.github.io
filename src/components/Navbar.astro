---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (currentPath === href ? "page" : undefined);
---

<nav class="navbar" aria-label="Main" transition:persist="navbar">
    <ul class="nav-list">
        <li><a href="/" class="nav-link" aria-current={current("/")}>Home<span class="nav-mark" aria-hidden="true"></span></a></li>
        <li><a href="/about/" class="nav-link" aria-current={current("/about")}>About<span class="nav-mark" aria-hidden="true"></span></a></li>
        <li><a href="/contact/" class="nav-link" aria-current={current("/contact")}>Contact<span class="nav-mark" aria-hidden="true"></span></a></li>
        <li class="theme-item">
            <button class="theme-btn" id="theme-btn" type="button" aria-label="Dark mode" aria-pressed="false" hidden>
                <svg class="theme-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                    <path d="M20.8 14.1A9 9 0 0 1 9.9 3.2 9 9 0 1 0 20.8 14.1Z"/>
                </svg>
                <svg class="theme-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v3m0 14v3M2 12h3m14 0h3M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2"/>
                </svg>
            </button>
        </li>
    </ul>
</nav>

<script is:inline>
    (function () {
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        function syncThemeButton() {
            const btn = document.getElementById("theme-btn");
            if (!btn) return;
            btn.hidden = false;
            btn.setAttribute(
                "aria-pressed",
                String(document.documentElement.classList.contains("dark")),
            );
        }

        function applyTheme(isDark) {
            window.applyTheme(isDark);
            syncThemeButton();
        }

        function syncActiveLink() {
            const trim = (p) => p.replace(/\/$/, "") || "/";
            const path = trim(window.location.pathname);
            document.querySelectorAll(".nav-link").forEach((link) => {
                if (trim(link.getAttribute("href")) === path) {
                    link.setAttribute("aria-current", "page");
                } else {
                    link.removeAttribute("aria-current");
                }
            });
        }

        function initNavbar() {
            syncActiveLink();
            syncThemeButton();

            const btn = document.getElementById("theme-btn");
            if (btn && !btn.dataset.initialized) {
                btn.dataset.initialized = "true";
                btn.addEventListener("click", () => {
                    const isDark = !document.documentElement.classList.contains("dark");
                    // Picking the system's own theme hands control back to the system.
                    if (isDark === media.matches) localStorage.removeItem("theme");
                    else localStorage.setItem("theme", isDark ? "dark" : "light");
                    applyTheme(isDark);
                });
            }
        }

        // Follow the system setting until the visitor picks a theme here.
        media.addEventListener("change", (e) => {
            if (!localStorage.getItem("theme")) applyTheme(e.matches);
        });

        document.addEventListener("astro:page-load", initNavbar);
        // Mark the new link inside the swap, so the view transition sees the mark move.
        document.addEventListener("astro:after-swap", syncActiveLink);
    })();
</script>

<script>
    import { prefetch } from "astro:prefetch";

    // Warm the cache with fetch, not <link rel="prefetch">, which Firefox skips when network.prefetch-next is off.
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => prefetch(link.href, { with: "fetch" }));
    });
</script>

<style>
    .navbar {
        position: relative;
        z-index: var(--z-sticky-nav);
        border-top: var(--rule-bar) solid var(--color-ink);
        border-bottom: var(--rule-hair) solid var(--color-rule);
    }

    .nav-list {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 0 var(--space-xs);
        max-width: var(--container);
        min-height: 64px;
        margin: 0 auto;
        padding: 0 var(--gutter);
        list-style: none;
    }

    .nav-list li {
        display: flex;
    }

    /* The links carry inline padding so the focus ring clears the text; the first one hangs into the gutter to keep the edge. */
    .nav-list li:first-child .nav-link {
        margin-left: calc(var(--space-xs) * -1);
    }

    .nav-link {
        display: flex;
        align-items: center;
        padding-inline: var(--space-xs);
        font-size: var(--text-md);
        font-weight: 500;
        color: var(--color-ink-2);
        text-decoration: none;
        position: relative;
        transition: color var(--dur-micro) var(--ease-out);
    }

    /* The tangerine mark sits on the nav's top rule, its own element so it can travel between links. */
    .nav-mark {
        position: absolute;
        inset-inline: 0;
        top: calc(var(--rule-bar) * -1);
        height: var(--rule-bar);
    }

    .nav-link[aria-current="page"] .nav-mark {
        background: var(--color-accent);
        view-transition-name: nav-mark;
    }

    .nav-link:hover {
        color: var(--color-ink);
        text-decoration-line: underline;
        text-decoration-color: var(--color-mark);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
    }

    .nav-link:active {
        text-decoration-color: var(--color-accent-deep);
    }

    .nav-link[aria-current="page"] {
        color: var(--color-ink);
        text-decoration-line: underline;
        text-decoration-color: var(--color-ink);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
    }

    .nav-link[aria-current="page"]:hover {
        text-decoration-color: var(--color-mark);
    }

    .nav-link:focus-visible {
        outline-offset: -2px;
    }

    .theme-item {
        margin-left: auto;
        align-items: center;
    }

    .theme-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        padding: 0;
        border: var(--rule-hair) solid transparent;
        border-radius: 0;
        background: transparent;
        color: var(--color-ink);
        cursor: pointer;
        transition: border-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out);
    }

    .theme-btn[hidden] {
        display: none;
    }

    .theme-btn:hover {
        border-color: var(--color-ink);
    }

    .theme-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .theme-btn:active {
        transform: translateY(1px);
    }

    .theme-btn:focus-visible {
        outline-offset: 2px;
    }

    .theme-btn[aria-pressed="false"] .theme-sun,
    .theme-btn[aria-pressed="true"] .theme-moon {
        display: none;
    }

    @media (max-width: 40rem) {
        .nav-list {
            gap: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-link,
        .theme-btn {
            transition: none;
        }
    }
</style>
