<script is:inline>
    (function () {
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        function syncThemeButtons() {
            const isDark = document.documentElement.classList.contains("dark");
            document.querySelectorAll(".js-theme-btn").forEach((btn) => {
                btn.hidden = false;
                btn.setAttribute("aria-pressed", String(isDark));
                btn.setAttribute("title", isDark ? "Switch to light mode" : "Switch to dark mode");
            });
        }

        let themeTransitionTimer = 0;

        function applyTheme(isDark) {
            const root = document.documentElement;
            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!reduced) {
                root.classList.add("theme-transition");
                window.clearTimeout(themeTransitionTimer);
                themeTransitionTimer = window.setTimeout(() => {
                    root.classList.remove("theme-transition");
                    themeTransitionTimer = 0;
                }, 340);
            }
            window.applyTheme(isDark);
            syncThemeButtons();
        }

        function currentHash() {
            const sections = ["about", "projects", "photography", "contact"].map((id) => document.getElementById(id)).filter(Boolean);
            const line = window.innerHeight / 3;
            let hash = "#home";
            for (const section of sections) {
                if (section.getBoundingClientRect().top <= line) hash = "#" + section.id;
            }
            const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
            if (atBottom && sections.length) hash = "#" + sections[sections.length - 1].id;
            return hash;
        }

        function syncDockVisibility() {
            const dock = document.getElementById("nav-dock");
            const topNav = document.querySelector(".nav-top");
            if (!dock || !topNav) return;
            dock.classList.add("is-managed");
            const visible = topNav.getBoundingClientRect().bottom < -40;
            dock.classList.toggle("is-visible", visible);
            dock.setAttribute("aria-hidden", String(!visible));
            dock.inert = !visible;
            if (!visible && dock.contains(document.activeElement)) {
                document.activeElement.blur();
            }
        }

        const SECTION_LABELS = {
            "#home": "Home",
            "#about": "About",
            "#projects": "Projects",
            "#photography": "Photography",
            "#contact": "Contact",
        };

        function syncActiveLink() {
            const { pathname } = window.location;
            const hash = currentHash();
            document.querySelectorAll(".nav-link").forEach((link) => {
                if (link.pathname === pathname && link.hash === hash) {
                    link.setAttribute("aria-current", "location");
                } else {
                    link.removeAttribute("aria-current");
                }
            });
            const label = SECTION_LABELS[hash] || "Menu";
            document.querySelectorAll(".js-nav-current").forEach((el) => {
                el.textContent = label;
            });
            syncDockVisibility();
        }

        function setDrawerExpanded(expanded) {
            document.querySelectorAll(".js-nav-menu-btn").forEach((btn) => {
                btn.setAttribute("aria-expanded", String(expanded));
            });
        }

        let closeTimer = 0;

        function finishCloseDrawer(drawer) {
            if (!drawer) return;
            window.clearTimeout(closeTimer);
            closeTimer = 0;
            delete drawer.dataset.closing;
            if (drawer.open) drawer.close();
            setDrawerExpanded(false);
        }

        function openDrawer(trigger) {
            const drawer = document.getElementById("nav-drawer");
            if (!drawer) return;
            if (drawer.dataset.closing === "true") {
                finishCloseDrawer(drawer);
            }
            if (drawer.open) return;

            const isDock = trigger?.classList.contains("nav-dock-menu");
            const anchor = isDock ? document.getElementById("nav-dock") || trigger : trigger;
            const rect = anchor?.getBoundingClientRect();
            const gap = 8;
            const pad = 16;

            drawer.dataset.placement = isDock ? "above" : "below";
            drawer.style.top = "";
            drawer.style.bottom = "";
            drawer.style.left = "";

            drawer.showModal();
            setDrawerExpanded(true);

            if (rect) {
                const menuWidth = drawer.getBoundingClientRect().width;
                const maxLeft = Math.max(pad, window.innerWidth - menuWidth - pad);
                if (isDock) {
                    const centered = rect.left + rect.width / 2 - menuWidth / 2;
                    drawer.style.left = `${Math.round(Math.min(maxLeft, Math.max(pad, centered)))}px`;
                    drawer.style.bottom = `${Math.round(window.innerHeight - rect.top + gap)}px`;
                    drawer.style.top = "auto";
                } else {
                    drawer.style.left = `${Math.round(Math.min(maxLeft, Math.max(pad, rect.left)))}px`;
                    drawer.style.top = `${Math.round(rect.bottom + gap)}px`;
                    drawer.style.bottom = "auto";
                }
            }
        }

        function closeDrawer() {
            const drawer = document.getElementById("nav-drawer");
            if (!drawer || !drawer.open || drawer.dataset.closing === "true") return;

            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (reduced) {
                finishCloseDrawer(drawer);
                return;
            }

            drawer.dataset.closing = "true";
            setDrawerExpanded(false);
            window.clearTimeout(closeTimer);
            closeTimer = window.setTimeout(() => finishCloseDrawer(drawer), 320);
        }

        function initNavbar() {
            const navRoot = document.getElementById("nav-root");
            if (navRoot) navRoot.classList.add("has-mobile-drawer");

            document.querySelectorAll(".js-nav-menu-btn").forEach((btn) => {
                btn.hidden = false;
                if (btn.dataset.drawerInit) return;
                btn.dataset.drawerInit = "true";
                btn.addEventListener("click", () => {
                    const drawer = document.getElementById("nav-drawer");
                    if (drawer?.open) closeDrawer();
                    else openDrawer(btn);
                });
            });

            const drawer = document.getElementById("nav-drawer");
            if (drawer && !drawer.dataset.drawerInit) {
                drawer.dataset.drawerInit = "true";
                drawer.addEventListener("cancel", (e) => {
                    e.preventDefault();
                    closeDrawer();
                });
                drawer.addEventListener("transitionend", (e) => {
                    if (e.target === drawer && e.propertyName === "opacity" && drawer.dataset.closing === "true") {
                        finishCloseDrawer(drawer);
                    }
                });
                drawer.addEventListener("close", () => {
                    delete drawer.dataset.closing;
                    setDrawerExpanded(false);
                });
                drawer.addEventListener("click", (e) => {
                    if (e.target === drawer) closeDrawer();
                });
                drawer.querySelectorAll(".nav-drawer-link").forEach((link) => {
                    link.addEventListener("click", closeDrawer);
                });
            }

            syncActiveLink();
            syncThemeButtons();

            document.querySelectorAll(".js-theme-btn").forEach((btn) => {
                if (btn.dataset.initialized) return;
                btn.dataset.initialized = "true";
                btn.addEventListener("click", () => {
                    const isDark = !document.documentElement.classList.contains("dark");
                    if (isDark === media.matches) localStorage.removeItem("theme");
                    else localStorage.setItem("theme", isDark ? "dark" : "light");
                    applyTheme(isDark);
                });
            });

            document.querySelectorAll('a[href="/#home"]').forEach((link) => {
                if (link.dataset.homeInit) return;
                link.dataset.homeInit = "true";
                link.addEventListener("click", (e) => {
                    if (window.location.pathname !== "/") return;
                    e.preventDefault();
                    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                    window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
                    if (window.location.hash) {
                        history.replaceState(null, "", "/");
                        syncActiveLink();
                    }
                });
            });
        }

        media.addEventListener("change", (e) => {
            if (!localStorage.getItem("theme")) applyTheme(e.matches);
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initNavbar, { once: true });
        } else {
            initNavbar();
        }
        window.addEventListener("hashchange", syncActiveLink);

        let syncFrame = 0;
        const scheduleSyncActiveLink = () => {
            if (syncFrame) return;
            syncFrame = requestAnimationFrame(() => {
                syncFrame = 0;
                syncActiveLink();
            });
        };
        window.addEventListener("scroll", scheduleSyncActiveLink, { passive: true });
        window.addEventListener("resize", () => {
            if (window.innerWidth > 576) closeDrawer();
            scheduleSyncActiveLink();
        }, { passive: true });
    })();
</script>

<style>
