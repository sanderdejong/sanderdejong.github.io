    }

    .nav-link[aria-current="location"] {
        color: var(--color-band-ink);
    }

    .nav-link[aria-current="location"] .nav-mark {
        background: var(--color-pop);
        view-transition-name: nav-mark;
    }

    @media (hover: hover) and (pointer: fine) {
        .nav-link:hover {
            color: var(--color-band-ink);
        }

        .nav-link:hover .nav-mark,
        .nav-link[aria-current="location"]:hover .nav-mark {
            background: var(--color-band-ink);
        }
    }

    .nav-link:active .nav-mark,
    .nav-link[aria-current="location"]:active .nav-mark {
        background: var(--color-pop);
    }

    .nav-link:focus-visible {
        outline-offset: -2px;
    }

    .theme-btn {
        align-self: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        padding: 0;
        border: none;
        border-radius: 0;
        background: transparent;
        color: var(--color-band-ink);
        cursor: pointer;
        transition: transform var(--dur-micro) var(--ease-out);
    }

    .theme-btn[hidden] {
