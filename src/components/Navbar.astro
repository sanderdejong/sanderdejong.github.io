        padding-block: var(--space-lg) var(--space-xs);
    }

    .nav-top-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2xs);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-top-list li {
        display: flex;
    }

    .nav-top-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-pill);
        font-size: var(--text-md);
        font-weight: 500;
        color: var(--color-muted);
        text-decoration: none;
        white-space: nowrap;
        transition:
            color var(--dur-micro) var(--ease-out),
            background-color var(--dur-micro) var(--ease-out);
    }

    .nav-top-link[aria-current="location"] {
        color: var(--color-nav-active);
        background: var(--color-nav-pill);
    }

    @media (hover: hover) and (pointer: fine) {
        .nav-top-link:hover {
            color: var(--color-ink);
            background: color-mix(in oklab, var(--color-ink) 6%, transparent);
        }

        .nav-top-link[aria-current="location"]:hover {
            color: var(--color-nav-active);
            background: var(--color-nav-pill);
        }
    }

    .nav-top-link:focus-visible {
        outline-offset: 2px;
    }

    /* Scroll-revealed Frosted Adaptive bottom dock */
    .nav-dock {
        position: fixed;
        inset-inline: 0;
        inset-block-end: max(18px, env(safe-area-inset-bottom));
        margin-inline: auto;
        width: fit-content;
        z-index: var(--z-sticky-nav);
        display: flex;
        align-items: center;
        gap: var(--space-2xs);
        max-width: calc(100% - var(--space-md));
        padding: var(--space-2xs) var(--space-xs);
        border-radius: var(--radius-portrait);
        background: var(--color-nav-bg);
        backdrop-filter: blur(18px) saturate(1.35);
        -webkit-backdrop-filter: blur(18px) saturate(1.35);
        border: 1px solid var(--color-nav-border);
        box-shadow: var(--shadow-nav);
        color: var(--color-nav-ink);
        transform: translateY(0) scale(1);
        transition:
            opacity var(--dur-long) var(--ease-in-out),
            transform var(--dur-long) var(--ease-out),
            visibility 0s linear 0s;
    }

    .nav-dock.is-managed:not(.is-visible) {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(10px) scale(0.98);
        transition:
            opacity var(--dur-short) var(--ease-in-out),
            transform var(--dur-short) var(--ease-in-out),
            visibility 0s linear var(--dur-short);
    }

    .nav-dock-list {
        display: flex;
        align-items: center;
        gap: 2px;
        min-width: 0;
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
    }

    .nav-dock-list::-webkit-scrollbar {
        display: none;
    }

    .nav-dock-list li {
        display: flex;
    }

    .nav-dock-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-pill);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-nav-muted);
        text-decoration: none;
        white-space: nowrap;
        transition:
            color var(--dur-micro) var(--ease-out),
            background-color var(--dur-micro) var(--ease-out);
    }

    .nav-dock-link[aria-current="location"] {
        color: var(--color-nav-active);
        background: var(--color-nav-pill);
    }

    @media (hover: hover) and (pointer: fine) {
        .nav-dock-link:hover {
            color: var(--color-nav-ink);
            background: color-mix(in oklab, var(--color-nav-ink) 8%, transparent);
        }

        .nav-dock-link[aria-current="location"]:hover {
            color: var(--color-nav-active);
            background: var(--color-nav-pill);
        }
    }

    .nav-dock-link:focus-visible {
        outline-offset: 2px;
    }

    .nav-menu-btn {
        display: none;
        align-items: center;
        gap: var(--space-xs);
        min-height: 44px;
        padding: var(--space-xs) var(--space-sm);
        border: 0;
        border-radius: var(--radius-pill);
        background: transparent;
        font-size: var(--text-sm);
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition:
            color var(--dur-micro) var(--ease-out),
            background-color var(--dur-micro) var(--ease-out);
    }

    .nav-top-menu {
        color: var(--color-nav-active);
        background: var(--color-nav-pill);
    }

    .nav-dock-menu {
        color: var(--color-nav-ink);
    }

    @media (hover: hover) and (pointer: fine) {
        .nav-top-menu:hover {
            background: color-mix(in oklab, var(--color-accent) 20%, transparent);
        }

        .nav-dock-menu:hover {
            background: color-mix(in oklab, var(--color-nav-ink) 8%, transparent);
        }
    }

    .nav-menu-btn:focus-visible {
        outline-offset: 2px;
    }

    .nav-dock-sep {
        width: 1px;
        height: 18px;
        margin-inline: 2px;
        background: var(--color-nav-border);
        flex-shrink: 0;
    }

    /* Shared theme button styles */
    .theme-btn {
        align-self: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: var(--radius-pill);
        background: transparent;
        cursor: pointer;
        flex-shrink: 0;
        transition:
            color var(--dur-micro) var(--ease-out),
            background-color var(--dur-micro) var(--ease-out),
            transform var(--dur-micro) var(--ease-out);
    }

    .nav-top-theme {
        min-width: 44px;
        min-height: 44px;
        color: var(--color-muted);
    }

    .nav-dock-theme {
        min-width: 44px;
        min-height: 44px;
        color: var(--color-nav-muted);
    }

    .theme-btn[hidden] {
        display: none;
    }

    .theme-moon path,
    .theme-sun circle {
        fill: transparent;
        transition: fill var(--dur-micro) var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        .nav-top-theme:hover {
            color: var(--color-ink);
            background: color-mix(in oklab, var(--color-ink) 6%, transparent);
        }

        .nav-dock-theme:hover {
            color: var(--color-nav-ink);
            background: color-mix(in oklab, var(--color-nav-ink) 8%, transparent);
        }

        .theme-btn:hover .theme-moon path,
        .theme-btn:hover .theme-sun circle {
            fill: currentColor;
        }

        .theme-btn:active {
            transform: translateY(1px);
        }
    }

    .theme-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .theme-btn:focus-visible {
        outline-offset: 2px;
    }

    .theme-btn[aria-pressed="false"] .theme-sun,
    .theme-btn[aria-pressed="true"] .theme-moon {
        display: none;
    }

    /* Compact anchored mobile navigation popover */
    .nav-drawer {
        position: fixed;
        inset: auto;
        margin: 0;
        width: min(13.5rem, calc(100vw - var(--space-lg)));
        padding: var(--space-xs);
        border: 1px solid var(--color-nav-border);
        border-radius: var(--radius-portrait);
        background: var(--color-nav-bg);
        backdrop-filter: blur(18px) saturate(1.35);
        -webkit-backdrop-filter: blur(18px) saturate(1.35);
        box-shadow: var(--shadow-nav);
        color: var(--color-nav-ink);
        opacity: 0;
        transform: translateY(-8px) scale(0.97);
        transition:
            opacity 320ms var(--ease-in-out),
            transform 320ms var(--ease-out),
            overlay 320ms allow-discrete,
            display 320ms allow-discrete;
    }

    .nav-drawer[data-placement="below"] {
        transform-origin: top left;
        transform: translateY(-8px) scale(0.97);
    }

    .nav-drawer[data-placement="above"] {
        transform-origin: bottom center;
        transform: translateY(8px) scale(0.97);
    }

    .nav-drawer[open] {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .nav-drawer[data-closing="true"] {
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 280ms var(--ease-in-out),
            transform 280ms var(--ease-in-out);
    }

    .nav-drawer[data-closing="true"][data-placement="below"] {
        transform: translateY(-6px) scale(0.975);
    }

    .nav-drawer[data-closing="true"][data-placement="above"] {
        transform: translateY(6px) scale(0.975);
    }

    @starting-style {
        .nav-drawer[open][data-placement="below"] {
            opacity: 0;
            transform: translateY(-8px) scale(0.97);
        }

        .nav-drawer[open][data-placement="above"] {
            opacity: 0;
            transform: translateY(8px) scale(0.97);
        }
    }

    .nav-drawer::backdrop {
        background: oklch(14% 0.015 45 / 0.16);
        opacity: 0;
        transition:
            opacity 320ms var(--ease-in-out),
            overlay 320ms allow-discrete,
            display 320ms allow-discrete;
    }

    .nav-drawer[open]::backdrop {
        opacity: 1;
    }

    .nav-drawer[data-closing="true"]::backdrop {
        opacity: 0;
        transition: opacity 280ms var(--ease-in-out);
    }

    @starting-style {
        .nav-drawer[open]::backdrop {
            opacity: 0;
        }
    }

    .nav-drawer-list {
        display: grid;
        gap: var(--space-3xs);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-drawer-link {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-pill);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-nav-muted);
        text-decoration: none;
        transition:
            color var(--dur-micro) var(--ease-out),
            background-color var(--dur-micro) var(--ease-out);
    }

    .nav-drawer-link[aria-current="location"] {
        color: var(--color-nav-active);
        background: var(--color-nav-pill);
    }

