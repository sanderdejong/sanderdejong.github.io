---
import { Image, getImage } from 'astro:assets';
import ContentWithHeading from './ContentWithHeading.astro';
import { photoCategories } from '../data/photography';

const serializedCategories = await Promise.all(
    photoCategories.map(async (category) => ({
        slug: category.slug,
        title: category.title,
        summary: category.summary,
        photos: await Promise.all(
            category.photos.map(async (photo) => {
                const full = photo.src
                    ? await getImage({ src: photo.src, width: 1400, format: 'webp' })
                    : null;
                const thumb = photo.src
                    ? await getImage({ src: photo.src, width: 160, format: 'webp' })
                    : null;
                return {
                    id: photo.id,
                    title: photo.title,
                    alt: photo.alt,
                    src: full?.src ?? null,
                    thumbSrc: thumb?.src ?? full?.src ?? null,
                    width: photo.src?.width ?? null,
                    height: photo.src?.height ?? null,
                    aspect: photo.aspect ?? '3 / 2',
                    location: photo.location ?? null,
                    date: photo.date ?? null,
                    camera: photo.camera ?? null,
                    lens: photo.lens ?? null,
                    settings: photo.settings ?? null,
                };
            }),
        ),
    })),
);
---
    <ContentWithHeading id="photography">
        <div class="photo-band">
            <h2 id="photography-heading">photography<span class="period">.</span></h2>

            <ul class="photo-categories" role="list">
                {photoCategories.map((category) => {
                    const cover = category.photos[category.coverIndex ?? 0];
                    const countLabel = category.photos.length === 1 ? '1 photo' : `${category.photos.length} photos`;
                    return (
                        <li>
                            <button
                                type="button"
                                class="card-surface photo-category-card"
                                data-photo-category={category.slug}
                                aria-haspopup="dialog"
                                aria-controls="photo-dialog"
                            >
                                <span class="photo-cover" aria-hidden="true">
                                    {cover?.src ? (
                                        <Image
                                            class="photo-cover-img"
                                            src={cover.src}
                                            alt=""
                                            widths={[480, 768]}
                                            sizes="(min-width: 52rem) 30vw, 92vw"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    ) : (
                                        <span class="photo-placeholder">
                                            <span class="photo-placeholder-frame">
                                                <span class="photo-placeholder-mark">{category.title.slice(0, 1)}<span class="period">.</span></span>
                                                <span class="photo-placeholder-hint">Cover photo</span>
                                            </span>
                                        </span>
                                    )}
                                </span>
                                <span class="photo-card-body">
                                    <span class="photo-card-title">{category.title}</span>
                                    <span class="photo-card-summary">{category.summary}</span>
                                    <span class="photo-card-footer">
                                        <span class="photo-card-count">{countLabel}</span>
                                        <svg aria-hidden="true" class="photo-card-arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
                                    </span>
                                </span>
                            </button>
                        </li>
                    );
                })}
            </ul>
        </div>

        <dialog class="photo-dialog" id="photo-dialog" aria-labelledby="photo-dialog-title">
            <div class="photo-dialog-inner" data-photo-backdrop>
                <header class="photo-dialog-header">
                    <div class="photo-dialog-heading">
                        <h3 id="photo-dialog-title" class="photo-dialog-title"></h3>
                        <span class="photo-dialog-counter" data-photo-counter aria-live="polite"></span>
                    </div>
                    <div class="photo-thumbs" data-photo-thumbs role="group" aria-label="Select photo"></div>
                    <button type="button" class="photo-dialog-close" data-photo-close aria-label="Close gallery">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M6 6 18 18"/><path d="M18 6 6 18"/></svg>
                    </button>
                </header>

                <div class="photo-stage-wrap" data-photo-backdrop>
                    <button type="button" class="photo-nav-btn" data-photo-prev aria-label="Previous photo">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M19 12H5"/><path d="m11 6-6 6 6 6"/></svg>
                    </button>

                    <figure class="photo-stage" data-photo-stage data-photo-backdrop>
                        <div class="photo-stage-media" data-photo-media data-photo-backdrop></div>
                    </figure>

                    <button type="button" class="photo-nav-btn" data-photo-next aria-label="Next photo">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
                    </button>
                </div>

                <footer class="photo-dialog-footer">
                    <dl class="photo-meta" data-photo-meta></dl>
                </footer>
            </div>
        </dialog>

        <script type="application/json" id="photo-categories-data" set:html={JSON.stringify(serializedCategories)}></script>
    </ContentWithHeading>

<script>
    interface SerializedPhoto {
        id: string;
        title: string;
        alt: string;
        src: string | null;
        thumbSrc: string | null;
        width: number | null;
        height: number | null;
        aspect: string;
        location: string | null;
        date: string | null;
        camera: string | null;
        lens: string | null;
        settings: string | null;
    }

    interface SerializedCategory {
        slug: string;
        title: string;
        summary: string;
        photos: SerializedPhoto[];
    }

    const initPhotographyGallery = () => {
        const dialog = document.getElementById('photo-dialog') as HTMLDialogElement | null;
        const dataEl = document.getElementById('photo-categories-data');
        if (!dialog || !dataEl || dialog.dataset.bound === 'true') return;
        dialog.dataset.bound = 'true';

        let categories: SerializedCategory[] = [];
        try {
            categories = JSON.parse(dataEl.textContent || '[]');
        } catch {
            return;
        }

        const titleEl = document.getElementById('photo-dialog-title');
        const counterEl = dialog.querySelector<HTMLElement>('[data-photo-counter]');
        const mediaEl = dialog.querySelector<HTMLElement>('[data-photo-media]');
        const metaEl = dialog.querySelector<HTMLElement>('[data-photo-meta]');
        const thumbsEl = dialog.querySelector<HTMLElement>('[data-photo-thumbs]');
        const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-photo-prev]');
        const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-photo-next]');
        const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-photo-close]');

        let activeCategory: SerializedCategory | null = null;
        let activeIndex = 0;
        let lastTrigger: HTMLButtonElement | null = null;
        let renderToken = 0;
        const imageCache = new Map<string, Promise<HTMLImageElement>>();

        const preloadPhoto = (src: string, alt: string, width: number | null, height: number | null) => {
            const existing = imageCache.get(src);
            if (existing) return existing;

            const promise = new Promise<HTMLImageElement>((resolve) => {
                const img = new Image();
                img.className = 'photo-stage-img';
                img.alt = alt;
                if (width) img.width = width;
                if (height) img.height = height;
                img.decoding = 'async';
                img.src = src;

                const finish = () => resolve(img);
                if (img.complete && img.naturalWidth > 0) {
                    finish();
                } else if (typeof img.decode === 'function') {
                    img.decode().then(finish, finish);
                } else {
                    img.addEventListener('load', finish, { once: true });
                    img.addEventListener('error', finish, { once: true });
                }
            });

            imageCache.set(src, promise);
            return promise;
        };

        const warmCategory = (category: SerializedCategory, limit = category.photos.length) => {
            for (const photo of category.photos.slice(0, limit)) {
                if (photo.src) {
                    preloadPhoto(photo.src, photo.alt, photo.width, photo.height);
                }
            }
        };

        const updateThumbFades = () => {
            if (!thumbsEl) return;
            const maxScroll = thumbsEl.scrollWidth - thumbsEl.clientWidth;
            if (maxScroll <= 1) {
                delete thumbsEl.dataset.fadeLeft;
                delete thumbsEl.dataset.fadeRight;
                return;
            }
            if (thumbsEl.scrollLeft > 2) {
                thumbsEl.dataset.fadeLeft = 'true';
            } else {
                delete thumbsEl.dataset.fadeLeft;
            }
            if (thumbsEl.scrollLeft < maxScroll - 2) {
                thumbsEl.dataset.fadeRight = 'true';
            } else {
                delete thumbsEl.dataset.fadeRight;
            }
        };

        thumbsEl?.addEventListener('scroll', updateThumbFades, { passive: true });
        window.addEventListener('resize', () => {
            if (dialog.open) updateThumbFades();
        });

        const swapStageMedia = (nextEl: HTMLElement, direction: number) => {
            if (!mediaEl) return;
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const currentEl = mediaEl.querySelector<HTMLElement>(':scope > :not([data-exiting="true"])');

            if (!currentEl || direction === 0 || reducedMotion || typeof nextEl.animate !== 'function') {
                mediaEl.replaceChildren(nextEl);
                return;
            }

            mediaEl.querySelectorAll('[data-exiting="true"]').forEach((el) => el.remove());

            const distance = mediaEl.clientWidth + 32;
            const duration = 480;
            const easing = 'cubic-bezier(0.32, 0.72, 0, 1)';
            currentEl.dataset.exiting = 'true';
            currentEl.style.pointerEvents = 'none';

            mediaEl.appendChild(nextEl);

            const outAnim = currentEl.animate(
                [
                    { transform: 'translateX(0)' },
                    { transform: `translateX(${-direction * distance}px)` },
                ],
                { duration, easing, fill: 'forwards' },
            );
            outAnim.addEventListener('finish', () => currentEl.remove(), { once: true });

            nextEl.animate(
                [
                    { transform: `translateX(${direction * distance}px)` },
                    { transform: 'translateX(0)' },
                ],
                { duration, easing },
            );
        };

        const renderPhoto = (index: number, direction = 0) => {
            if (!activeCategory || !mediaEl || !metaEl || !counterEl || !thumbsEl) return;
            const total = activeCategory.photos.length;
            if (total === 0) return;

            activeIndex = ((index % total) + total) % total;
            const photo = activeCategory.photos[activeIndex];
            const token = ++renderToken;

            counterEl.textContent = `${activeIndex + 1} / ${total}`;

            if (photo.src) {
                preloadPhoto(photo.src, photo.alt, photo.width, photo.height).then((loadedImg) => {
                    if (token !== renderToken || !mediaEl) return;
                    const displayImg = loadedImg.cloneNode(false) as HTMLImageElement;
                    displayImg.alt = photo.alt;
                    swapStageMedia(displayImg, direction);
                });
            } else {
                const frame = document.createElement('div');
                frame.className = 'photo-stage-placeholder';
                frame.style.aspectRatio = photo.aspect;

                const label = document.createElement('span');
                label.className = 'photo-stage-placeholder-title';
                label.textContent = photo.title;

                const hint = document.createElement('span');
                hint.className = 'photo-stage-placeholder-hint';
                hint.textContent = `${photo.aspect.replace(/\s+/g, '')} frame`;

                frame.append(label, hint);
                swapStageMedia(frame, direction);
            }

            metaEl.replaceChildren();
            const gear = [photo.camera, photo.lens, photo.settings].filter(Boolean).join(', ');
            const fields: Array<[string, string | null]> = [
                ['Location', photo.location],
                ['Date', photo.date],
                ['Camera & lens', gear || null],
            ];

            for (const [label, value] of fields) {
                if (!value) continue;
                const item = document.createElement('div');
                item.className = 'photo-meta-item';

                const dt = document.createElement('dt');
                dt.textContent = label;

                const dd = document.createElement('dd');
                dd.textContent = value;

                item.append(dt, dd);
                metaEl.appendChild(item);
            }

            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            thumbsEl.querySelectorAll<HTMLButtonElement>('[data-photo-thumb]').forEach((btn, i) => {
                if (i === activeIndex) {
                    btn.setAttribute('aria-current', 'true');
                    btn.scrollIntoView({
                        behavior: reducedMotion ? 'auto' : 'smooth',
                        inline: 'center',
                        block: 'nearest',
                    });
                } else {
                    btn.removeAttribute('aria-current');
                }
            });

            if (prevBtn) prevBtn.disabled = total <= 1;
            if (nextBtn) nextBtn.disabled = total <= 1;
            requestAnimationFrame(updateThumbFades);
        };

        const openCategory = (slug: string, trigger: HTMLButtonElement) => {
            const category = categories.find((item) => item.slug === slug);
            if (!category || !titleEl || !thumbsEl) return;

            activeCategory = category;
            lastTrigger = trigger;
            warmCategory(category);

            titleEl.replaceChildren(
                document.createTextNode(category.title.toLowerCase()),
                Object.assign(document.createElement('span'), { className: 'period', textContent: '.' }),
            );

            thumbsEl.replaceChildren();
            category.photos.forEach((photo, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'photo-thumb';
                btn.dataset.photoThumb = String(idx);
                btn.setAttribute('aria-label', `Show ${photo.title}`);

                if (photo.thumbSrc || photo.src) {
                    const img = document.createElement('img');
                    img.src = photo.thumbSrc || photo.src;
                    img.alt = '';
                    btn.appendChild(img);
                } else {
                    const num = document.createElement('span');
                    num.className = 'photo-thumb-num';
                    num.textContent = String(idx + 1).padStart(2, '0');
                    btn.appendChild(num);
                }

                btn.addEventListener('click', () => {
                    if (idx === activeIndex) return;
                    renderPhoto(idx, idx > activeIndex ? 1 : -1);
                });
                thumbsEl.appendChild(btn);
            });

            mediaEl?.replaceChildren();
            renderPhoto(0);
            dialog.showModal();
            requestAnimationFrame(updateThumbFades);
            closeBtn?.focus({ preventScroll: true });
        };

        document.querySelectorAll<HTMLButtonElement>('[data-photo-category]').forEach((btn) => {
            const warm = () => {
                const slug = btn.dataset.photoCategory;
                const category = slug ? categories.find((item) => item.slug === slug) : null;
                if (category) warmCategory(category, 1);
            };
            btn.addEventListener('pointerenter', warm, { once: true });
            btn.addEventListener('focus', warm, { once: true });
            btn.addEventListener('click', () => {
                const slug = btn.dataset.photoCategory;
                if (slug) openCategory(slug, btn);
            });
        });

        let isClosing = false;

        const closeDialog = () => {
            if (!dialog.open || isClosing) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                dialog.close();
                return;
            }
            isClosing = true;
            dialog.dataset.closing = 'true';

            const finish = () => {
                if (!isClosing) return;
                isClosing = false;
                if (dialog.open) dialog.close();
                delete dialog.dataset.closing;
            };

            dialog.addEventListener('transitionend', (event) => {
                if (event.target === dialog && event.propertyName === 'opacity') finish();
            }, { once: true });
            window.setTimeout(finish, 360);
        };

        prevBtn?.addEventListener('click', () => renderPhoto(activeIndex - 1, -1));
        nextBtn?.addEventListener('click', () => renderPhoto(activeIndex + 1, 1));
        closeBtn?.addEventListener('click', closeDialog);

        dialog.addEventListener('cancel', (event) => {
            event.preventDefault();
            closeDialog();
        });

        dialog.addEventListener('wheel', (event) => {
            const target = event.target as HTMLElement | null;
            if (target?.closest('[data-photo-thumbs]') && Math.abs(event.deltaX) > Math.abs(event.deltaY)) {
                return;
            }
            if (dialog.scrollHeight > dialog.clientHeight) {
                return;
            }
            event.preventDefault();
        }, { passive: false });

        dialog.addEventListener('click', (event) => {
            const target = event.target as HTMLElement | null;
            if (target === dialog || target?.hasAttribute('data-photo-backdrop')) {
                closeDialog();
            }
        });

        dialog.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') {
                event.preventDefault();
                renderPhoto(activeIndex - 1, -1);
            } else if (event.key === 'ArrowRight') {
                event.preventDefault();
                renderPhoto(activeIndex + 1, 1);
            }
        });

        let touchStartX = 0;
        let touchStartY = 0;
        let touchActive = false;

        mediaEl?.addEventListener('touchstart', (event) => {
            if (event.touches.length !== 1) {
                touchActive = false;
                return;
            }
            touchStartX = event.touches[0].clientX;
            touchStartY = event.touches[0].clientY;
            touchActive = true;
        }, { passive: true });

        mediaEl?.addEventListener('touchend', (event) => {
            if (!touchActive || !activeCategory || activeCategory.photos.length <= 1) {
                touchActive = false;
                return;
            }
            touchActive = false;
            const touch = event.changedTouches[0];
            if (!touch) return;
            const dx = touch.clientX - touchStartX;
            const dy = touch.clientY - touchStartY;
            if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy) * 1.2) {
                if (dx < 0) {
                    renderPhoto(activeIndex + 1, 1);
                } else {
                    renderPhoto(activeIndex - 1, -1);
                }
            }
        }, { passive: true });

        mediaEl?.addEventListener('touchcancel', () => {
            touchActive = false;
        }, { passive: true });

        dialog.addEventListener('close', () => {
            lastTrigger?.focus({ preventScroll: true });
        });
    };

    initPhotographyGallery();
</script>

<style>
    .photo-band {
        position: relative;
        isolation: isolate;
        display: grid;
        gap: var(--space-xl);
        width: 100%;
        padding-block: var(--section-pad);
        padding-inline: 0;
        background: var(--color-band);
        color: var(--color-band-ink);
        box-shadow: 0 0 0 100vmax var(--color-band);
        clip-path: inset(0 -100vmax);
    }

    .photo-band::before {
        content: "";
        position: absolute;
        inset: 0 -100vmax;
        z-index: -1;
        pointer-events: none;
        background-image: radial-gradient(var(--color-band-dot) 1px, transparent 1px);
        background-size: 20px 20px;
        background-position: 50% var(--dot-offset-y, 0px);
        mask-image: linear-gradient(to right, transparent calc(50% - 50vw), #000 calc(50% - 32vw), #000 calc(50% + 32vw), transparent calc(50% + 50vw));
        -webkit-mask-image: linear-gradient(to right, transparent calc(50% - 50vw), #000 calc(50% - 32vw), #000 calc(50% + 32vw), transparent calc(50% + 50vw));
    }

    .photo-band h2 {
        font-size: min(var(--text-section), 14cqi);
        max-width: none;
        color: inherit;
        text-wrap: balance;
    }

    .photo-band :global(.period) {
        color: var(--color-pop);
    }

    .photo-categories {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-lg);
        width: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .photo-categories li {
        display: flex;
        min-width: 0;
    }

    .photo-category-card {
        display: grid;
        grid-template-rows: auto 1fr;
        width: 100%;
        padding: 0;
        border: 1px solid var(--color-band-card-border);
        border-radius: var(--radius-card);
        overflow: hidden;
        color: var(--color-ink);
        text-align: left;
        cursor: pointer;
        box-shadow: var(--shadow-band-card);
        transition:
            box-shadow var(--dur-short) var(--ease-out),
            border-color var(--dur-short) var(--ease-out),
            transform var(--dur-short) var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        .photo-category-card:hover {
            border-color: var(--color-hover-border);
            box-shadow: var(--shadow-band-card-hover);
            transform: translateY(-3px);
        }

        .photo-category-card:active {
            transform: translateY(-1px);
        }
    }

    .photo-category-card:focus-visible {
        outline: 2px solid var(--color-pop);
        outline-offset: 4px;
    }

    .photo-cover {
        display: block;
        aspect-ratio: 4 / 3;
        width: 100%;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-paper-2);
    }

    .photo-cover-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--dur-long) var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        .photo-category-card:hover .photo-cover-img {
            transform: scale(1.03);
        }
    }

    .photo-placeholder {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        padding: var(--space-md);
        background: var(--color-paper-2);
    }

    .photo-placeholder-frame {
        display: grid;
        place-items: center;
        align-content: center;
        gap: var(--space-xs);
        width: 100%;
        height: 100%;
        border: var(--rule-hair) dashed var(--color-rule);
    }

    .photo-placeholder-mark {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        font-weight: var(--display-weight);
        line-height: 1;
        letter-spacing: var(--tracking-display);
        text-transform: uppercase;
        color: var(--color-ink);
    }

    .photo-placeholder-mark .period {
        color: var(--color-mark);
    }

    .photo-placeholder-hint {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-muted);
    }

    .photo-card-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        padding: var(--space-md);
    }

    .photo-card-title {
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: var(--display-weight);
        line-height: 1.15;
        text-decoration-line: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.16em;
        transition: color var(--dur-micro) var(--ease-out), text-decoration-color var(--dur-micro) var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        .photo-category-card:hover .photo-card-title {
            color: var(--color-mark);
            text-decoration-color: var(--color-mark);
        }
    }

    .photo-card-summary {
        font-family: var(--font-body);
        font-size: var(--text-md);
        line-height: 1.45;
        color: var(--color-ink-2);
    }

    .photo-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-block-start: auto;
        padding-block-start: var(--space-sm);
        border-top: var(--rule-hair) solid var(--color-rule);
        color: var(--color-muted);
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 500;
    }

    .photo-card-arrow {
        width: 1.15rem;
        height: 1.15rem;
        color: var(--color-mark);
        transition: transform var(--dur-micro) var(--ease-out);
    }

    @media (hover: hover) and (pointer: fine) {
        .photo-category-card:hover .photo-card-arrow {
            transform: translateX(3px);
        }
    }

    @container (max-width: 52rem) {
        .photo-categories {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    /* Full-bleed lightbox modal for photo-first viewing. */
    .photo-dialog {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100dvh;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--color-band-ink);
        overflow: auto;
        overscroll-behavior: contain;
        opacity: 0;
        transform: translateY(10px) scale(0.975);
