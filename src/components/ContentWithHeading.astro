---
---
<section class="content-block">
    <slot/>
</section>

<style>
    .content-block {
        container-type: inline-size;
        display: grid;
        gap: var(--space-md);
        justify-items: start;
    }

    /*
     * The display size never outgrows its column: "Sander de Jong." is held on one line and
     * runs about 7.04em wide, so 14cqi is the largest size that still fits beside the portrait.
     */
    .content-block :global(h1) {
        font-size: min(var(--text-display), 14cqi);
        max-width: none;
        text-wrap: balance;
        margin-top: -0.1em;
        margin-bottom: var(--space-md);
    }

    /* A heading with its standfirst reads as one unit: tight inside, the full step to the letter. */
    .content-block :global(hgroup) {
        display: grid;
        gap: var(--space-sm);
        margin-bottom: var(--space-md);
    }

    .content-block :global(hgroup h1) {
        margin-bottom: 0;
    }

    .content-block :global(.standfirst) {
        font-size: var(--text-xl);
        font-weight: 500;
        line-height: 1.25;
        text-wrap: balance;
        color: var(--color-mark);
    }

    .content-block :global(p:only-of-type:not(.standfirst)) {
        font-size: var(--text-lead);
        line-height: 1.45;
        max-width: 48ch;
    }


    .content-block :global(.nowrap) {
        white-space: nowrap;
    }

    .content-block :global(.period) {
        color: var(--color-mark);
    }

</style>
